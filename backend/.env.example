# Astra Protocol Environment & RPC Configuration Template
# Copy this file to .env and insert your API keys and wallet addresses

# Alchemy RPC
ALCHEMY_API_KEY=your_alchemy_api_key_here
ARBITRUM_SEPOLIA_RPC=https://arb-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here
ARBITRUM_MAINNET_RPC=https://arb-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# Deployer Wallets (DO NOT commit real private keys to git!)
EVM_DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
EVM_DEPLOYER_PRIVATE_KEY=your_evm_private_key_hex

SOLANA_DEPLOYER_PUBKEY=your_solana_devnet_pubkey
SOLANA_DEPLOYER_SECRET_HEX=your_solana_secret_hex

# High-Throughput Free Price Streams
PYTH_HERMES_ENDPOINT=https://hermes.pyth.network/v2/updates/price/latest
HYPERLIQUID_TESTNET_API=https://api.hyperliquid-testnet.xyz/info

# Dedicated Pyth / Douro Labs Institutional Feed
PYTH_DOURO_API_KEY=your_pyth_douro_api_key_here
PYTH_DOURO_BASE_URL=https://pyth.dourolabs.app/v1/fixed_rate@1000ms

PORT=4000
